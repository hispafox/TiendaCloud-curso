<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.2" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- EF Core SqlServer trae la 9.0.x de este paquete, con vulnerabilidades conocidas: se fija la 10. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Las fotos de ejemplo van dentro de la web: la primera vez las sube al almacenamiento. -->
  <ItemGroup>
    <EmbeddedResource Include="Fotos\*.svg" LogicalName="Fotos.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
